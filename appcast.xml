<?xml version="1.0" standalone="yes"?>
<!--
  Sparkle appcast feed for Gemini Subtitles. SUFeedURL in Info.plist points
  here. Each <item> is one release; Sparkle picks the newest whose
  sparkle:version is greater than the running app's CFBundleShortVersionString.

  This file is regenerated by ./publish-release.sh on every release. The
  initial v0.6.0 entry below is a SEED ONLY — its enclosure/signature are
  placeholders because v0.6.0 predates Sparkle integration. Sparkle will
  never offer v0.6.0 as an update (it is not newer than itself), so the
  bogus signature is harmless. The first ./publish-release.sh run for 0.7.0
  will insert a real signed item above this one; you can delete this seed
  entry any time after that.
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
    <channel>
        <title>Gemini Subtitles</title>
        <link>https://github.com/gordonxc/gemini-osd-subtitles</link>
        <description>Release feed for Gemini Subtitles</description>
        <language>en</language>
        <!-- SEED ENTRY — see comment above. Replace/remove after first real release. -->
        <item>
            <title>Version 0.6.0</title>
            <pubDate>Mon, 23 Jun 2026 00:00:00 +0000</pubDate>
            <sparkle:version>0.6.0</sparkle:version>
            <sparkle:edSignature>SEED_SIGNATURE_REPLACE_ON_FIRST_RELEASE</sparkle:edSignature>
            <description><![CDATA[Initial Sparkle feed seed. Not a real update target.]]></description>
            <enclosure
                url="https://github.com/gordonxc/gemini-osd-subtitles/releases/download/v0.5.0/GeminiSubtitles-v0.5.0.zip"
                sparkle:edSignature="SEED_SIGNATURE_REPLACE_ON_FIRST_RELEASE"
                length="0"
                type="application/octet-stream" />
        </item>
    </channel>
</rss>
